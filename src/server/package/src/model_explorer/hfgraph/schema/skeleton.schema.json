      "else",
      "body"
     ],
     "title": "Label",
     "type": "string"
    },
    "line_start": {
     "title": "Line Start",
     "type": "integer"
    },
    "line_end": {
     "title": "Line End",
     "type": "integer"
    }
   },
   "required": [
    "id",
    "label",
    "line_start",
    "line_end"
   ],
