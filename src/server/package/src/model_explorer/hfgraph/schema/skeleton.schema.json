    "$ref": "#/$defs/Branch"
   },
   "title": "Branches",
   "type": "array"
  },
  "instances": {
   "items": {
    "$ref": "#/$defs/Instance"
   },
   "title": "Instances",
   "type": "array"
  }
 },
