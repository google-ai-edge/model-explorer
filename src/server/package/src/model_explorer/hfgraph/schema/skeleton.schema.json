     "enum": [
      "if",
      "for",
      "while",
      "ternary"
     ],
     "title": "Kind",
     "type": "string"
    },
    "cond_src": {
     "title": "Cond Src",
     "type": "string"
    },
    "cond_kind": {
     "enum": [
      "config",
      "shape",
      "value",
      "guarded",
      "python",
      "unknown",
      "loop"
     ],
     "title": "Cond Kind",
     "type": "string"
    },
    "cond_hash": {
     "title": "Cond Hash",
     "type": "string"
    },
    "file": {
     "title": "File",
     "type": "string"
    },
    "line_start": {
     "title": "Line Start",
     "type": "integer"
    },
    "line_end": {
     "title": "Line End",
     "type": "integer"
    },
    "parent_region": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Parent Region"
    },
    "regions": {
     "items": {
      "$ref": "#/$defs/Region"
     },
     "title": "Regions",
     "type": "array"
    }
   },
   "required": [
    "id",
    "template",
    "kind",
    "cond_src",
    "cond_kind",
    "cond_hash",
    "file",
    "line_start",
    "line_end"
   ],
   "title": "Branch",
   "type": "object"
  },
  "FunctionTemplate": {
   "description": "A class forward (kind=forward) or a helper function (kind=function).",
