    "kind",
    "file",
    "line_start",
    "line_end"
   ],
   "title": "FunctionTemplate",
   "type": "object"
  },
  "Instance": {
   "description": "A statically known path: a module instance, call site, or branch region.",
   "properties": {
    "path": {
     "title": "Path",
     "type": "string"
