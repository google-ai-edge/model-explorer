# Driving runners: launching them on devices and talking to them.

load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")
load("@server_pypi//:requirements.bzl", "requirement")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "capture_writer",
    srcs = [
        "__init__.py",
        "capture_writer.py",
    ],
    deps = [
        "//model_debugger/server:package",
        "@protocol//model_debugger/protocol:runner_py_pb2",
    ],
)

py_library(
    name = "runner_client",
    srcs = [
        "__init__.py",
        "runner_client.py",
    ],
    deps = [
        ":capture_writer",
        ":launcher",
        "//model_debugger/server:package",
        "@protocol//model_debugger/protocol:runner_py_pb2",
        "@protocol//model_debugger/protocol:runner_py_pb2_grpc",
        requirement("grpcio"),
    ],
)

