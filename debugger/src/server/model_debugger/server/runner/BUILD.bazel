# Runs the real command-line runner too, when it is built (RUNNER_BINARY, or
# the runner's own Bazel build). The runner is outside Bazel's view, so the
# test is "external": Bazel runs it every time rather than reuse a result from
# before the runner was rebuilt.
py_test(
    name = "local_launcher_test",
    srcs = ["local_launcher_test.py"],
    tags = ["external"],
    deps = [
        ":launch_records",
        ":launcher",
        ":local_launcher",
        ":runner_builds",
        ":runner_client",
        ":tool",
        "//model_debugger/server/testing:fake_builds",
        "//model_debugger/server/testing:fake_runner",
        "//model_debugger/server/testing:real_runner",
        "//model_debugger/server/testing:test_main",
        "//model_debugger/server/util:json_file",
        "@protocol//model_debugger/protocol:runner_py_pb2",
        requirement("absl-py"),
    ],
)

