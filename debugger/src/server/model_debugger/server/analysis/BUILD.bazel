# Compares a real turn too, that the real runner captures from RUNNER_MODEL
# when both are there; they are outside Bazel's view, so the test is
# "external": Bazel runs it every time.
py_test(
    name = "token_analysis_test",
    srcs = ["token_analysis_test.py"],
    tags = ["external"],
    deps = [
        ":metrics",
        ":token_analysis",
        "//model_debugger/server/capture:capture_index",
        "//model_debugger/server/testing:capture_fixtures",
        "//model_debugger/server/testing:real_capture",
        "//model_debugger/server/testing:test_main",
        "//model_debugger/server/util:errors",
        requirement("absl-py"),
        requirement("numpy"),
        requirement("safetensors"),
    ],
)

# Compares a real turn too, that the real runner captures from RUNNER_MODEL
