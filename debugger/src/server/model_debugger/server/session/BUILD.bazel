# The Session itself: its stores, its jobs, and the Model Server that runs it
# on two runners.

load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")
load("@server_pypi//:requirements.bzl", "requirement")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "workspace",
    srcs = [
        "__init__.py",
        "workspace.py",
    ],
    deps = ["//model_debugger/server:package"],
)

py_library(
    name = "jobs",
