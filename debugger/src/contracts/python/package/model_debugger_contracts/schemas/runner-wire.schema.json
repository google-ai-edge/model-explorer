{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "model-debugger:runner-wire",
 "title": "RunnerWire",
 "description": "Every message of the Server <-> Runner WebSocket protocol, v4 and v5, under $defs as \"<sender>.<type>\". A text frame is one message. A v5 binary frame is a 4-byte big-endian header length, the message as its JSON header, then raw bytes in place of `data` (server.upload_chunk, runner.file_chunk). Written by runtime/runner_channel.py and RunnerCommandCodec.swift; fixtures/wire holds one example per message.",
 "type": "object",
 "required": [
  "type"
 ],
 "properties": {
  "type": {
   "type": "string"
  }
 },
 "$defs": {
  "uuid": {
   "type": "string",
   "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
  },
  "sha256": {
   "type": "string",
   "pattern": "^[0-9a-fA-F]{64}$"
  },
  "fileRecord": {
   "type": "object",
   "required": [
    "path",
    "size",
    "sha256"
   ],
   "additionalProperties": false,
   "properties": {
    "path": {
     "type": "string",
     "minLength": 1
    },
    "size": {
     "type": "integer",
     "minimum": 0
    },
    "sha256": {
     "type": "string",
     "pattern": "^[0-9a-fA-F]{64}$"
    }
   }
  },
  "server.activate": {
   "type": "object",
   "required": [
    "type",
    "requestId",
    "serverId",
    "sessionId",
    "runId"
   ],
   "properties": {
    "type": {
     "const": "activate"
    },
    "requestId": {
     "$ref": "#/$defs/uuid"
    },
    "serverId": {
     "type": "string",
     "minLength": 1,
     "maxLength": 256
    },
    "serverName": {
     "type": "string"
    },
    "sessionId": {
     "$ref": "#/$defs/uuid"
    },
    "sessionName": {
     "type": "string"
    },
    "runId": {
     "enum": [
      "ref",
      "target"
     ]
    },
    "buildId": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "server.heartbeat": {
   "type": "object",
   "required": [
    "type",
    "serverId",
    "sessionId",
    "sequence"
   ],
   "properties": {
    "type": {
     "const": "heartbeat"
    },
    "serverId": {
     "type": "string"
    },
    "sessionId": {
     "$ref": "#/$defs/uuid"
    },
    "sequence": {
     "type": "integer",
     "minimum": 1
    }
   },
   "additionalProperties": false
  },
  "server.model_info": {
   "type": "object",
