# service/ is the layer above llm: the protocol's Runner service on an
# llm::Runtime, and what it needs to answer GetInfo.

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//model_debugger/runner/testing:model_test.bzl", "model_test")

# Where a Runner keeps its files on this platform.
cc_library(
    name = "cache_directory",
    srcs = ["cache_directory.cc"],
    hdrs = ["cache_directory.h"],
    visibility = ["//model_debugger/runner/testing:__pkg__"],
)

cc_test(
    name = "cache_directory_test",
    srcs = ["cache_directory_test.cc"],
    deps = [
        ":cache_directory",
        "@com_google_googletest//:gtest_main",
    ],
)

# The model files a Runner keeps, which Runners on one machine share.
cc_library(
    name = "model_store",
    srcs = ["model_store.cc"],
    hdrs = ["model_store.h"],
    deps = [
        "@com_google_absl//absl/log",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
    ],
)

cc_test(
    name = "model_store_test",
    srcs = ["model_store_test.cc"],
    deps = [
        ":model_store",
        "//model_debugger/runner/testing:test_utils",
        "@com_google_absl//absl/base:log_severity",
        "@com_google_absl//absl/log:scoped_mock_log",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_googletest//:gtest_main",
    ],
)

cc_library(
    name = "host_info",
    # One source per platform family; a platform without one does not build.
    srcs = select({
        "@platforms//os:android": ["host_info_android.cc"],
        "@platforms//os:ios": ["host_info_apple.cc"],
        "@platforms//os:macos": ["host_info_apple.cc"],
    }),
    hdrs = ["host_info.h"],
    deps = [
        "@protocol//model_debugger/protocol:runner_cc_proto",
    ],
)

# A runtime's options against the JSON Schema it reports for them.
cc_library(
    name = "options_schema",
    srcs = ["options_schema.cc"],
    hdrs = ["options_schema.h"],
    # LiteRT-LM's test checks that its schemas use only the keywords
    # understood.
    visibility = ["//model_debugger/runner/llm/litert_lm:__pkg__"],
    deps = [
        "//model_debugger/runner/util:json",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@protobuf",
    ],
)

cc_test(
    name = "options_schema_test",
    srcs = ["options_schema_test.cc"],
    deps = [
        ":options_schema",
        "@com_google_absl//absl/status",
        "@com_google_googletest//:gtest_main",
        "@protobuf",
    ],
)

cc_library(
    name = "runner_service",
    srcs = ["runner_service.cc"],
    hdrs = ["runner_service.h"],
    visibility = ["//model_debugger/runner:__pkg__"],
    deps = [
        ":cache_directory",
        ":host_info",
        ":model_store",
        ":options_schema",
        "//model_debugger/runner/llm:runtime",
        "//model_debugger/runner/util:disk_space",
        "@boringssl//:crypto",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/strings:cord",
        "@grpc//:grpc++",
        "@protocol//model_debugger/protocol:runner_cc_grpc",
        "@protocol//model_debugger/protocol:runner_cc_proto",
    ],
)

# The service's own rules, on a runtime the test scripts: needs no model.
cc_test(
    name = "runner_service_rules_test",
    srcs = ["runner_service_rules_test.cc"],
    deps = [
        ":model_store",
        ":runner_service",
        "//model_debugger/runner/llm:runtime",
        "//model_debugger/runner/testing:test_utils",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/strings:cord",
        "@com_google_googletest//:gtest_main",
        "@grpc//:grpc++",
        "@protobuf",
        "@protocol//model_debugger/protocol:runner_cc_grpc",
        "@protocol//model_debugger/protocol:runner_cc_proto",
    ],
)

# The service end to end, on LiteRT-LM: skipped unless RUNNER_MODEL names a
# model.
model_test(
    name = "runner_service_test",
    srcs = ["runner_service_test.cc"],
    deps = [
        ":runner_service",
        "//model_debugger/runner/llm/litert_lm",
        "//model_debugger/runner/testing:test_utils",
        "@boringssl//:crypto",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_googletest//:gtest_main",
        "@grpc//:grpc++",
        "@protocol//model_debugger/protocol:runner_cc_grpc",
        "@protocol//model_debugger/protocol:runner_cc_proto",
    ],
)
