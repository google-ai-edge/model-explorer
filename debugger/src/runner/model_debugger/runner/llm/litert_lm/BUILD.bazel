# What a command-line Runner needs beside its binary to run on its own, and
# the facts of the LiteRT-LM commit (commit.json): what cli:keep keeps. Only
# macOS has a command-line Runner.
filegroup(
    name = "runtime_files",
    srcs = select({
        ":macos": ["@litert_lm_macos_arm64//:runtime_files"],
    }),
    visibility = ["//model_debugger/runner/cli:__pkg__"],
)

# A phone App's version: "<commit> (<commit date>)", of the LiteRT-LM it is
# built against, as its repository's commit.json says; the date as
# YYYY-MM-DD, left out if unknown. The App writes it into its own version
# info (app/), where the server reads it without launching the App.
_APP_VERSION = " && ".join([
    "commit=$$(sed -n 's/.*\"commit\": *\"\\([0-9a-f]\\{40\\}\\)\".*/\\1/p' $<)",
    "date=$$(sed -n 's/.*\"commit_date\": *\"\\([0-9]\\{4\\}-[0-9][0-9]-[0-9][0-9]\\).*/\\1/p' $<)",
    "test -n \"$$commit\"",
    "printf '%s%s\\n' \"$$commit\" \"$${date:+ ($$date)}\" > $@",
])

# Manual, as the Apps are: //... is built for this computer, not a phone.
genrule(
    name = "android_app_version",
    srcs = ["@litert_lm_android_arm64//:commit.json"],
    outs = ["android_app_version.txt"],
    cmd = _APP_VERSION,
    tags = ["manual"],
    visibility = ["//model_debugger/runner/app/android:__pkg__"],
)

genrule(
    name = "ios_app_version",
    srcs = select({
        ":ios_device": ["@litert_lm_ios_arm64//:commit.json"],
        ":ios_simulator": ["@litert_lm_ios_sim_arm64//:commit.json"],
    }),
    outs = ["ios_app_version.txt"],
    cmd = _APP_VERSION,
    tags = ["manual"],
    visibility = ["//model_debugger/runner/app/apple:__pkg__"],
)

# What litert_lm_library instantiates the @litert_lm repositories from.
exports_files([
    "litert_lm.BUILD",
    "litert_lm_ios.BUILD",
])
