{
  "name": "model-debugger",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "ng serve model_debugger --host 127.0.0.1 --port 4201",
    "build": "ng build model_debugger",
    "check": "ng build --configuration development",
    "verify": "../../ci/check_ui.sh",
    "ng": "ng",
    "watch": "ng build model_debugger --watch --configuration development",
    "postbuild": "node scripts/copy_license_notices.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:layering": "node scripts/check_layering.mjs",
    "test": "ng test"
  },
  "dependencies": {
    "@angular/animations": "20.1.2",
    "@angular/cdk": "20.1.2",
    "@angular/common": "20.1.2",
    "@angular/compiler": "20.1.2",
    "@angular/core": "20.1.2",
    "@angular/forms": "20.1.2",
    "@angular/material": "20.1.2",
    "@angular/platform-browser": "20.1.2",
    "@angular/router": "20.1.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0",
    "plotly.js-dist-min": "3.5.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.1.1",
    "@angular/build": "^20.1.1",
    "@angular/cli": "20.1.1",
    "@angular/compiler-cli": "20.1.2",
    "jsdom": "^26.1.0",
    "prettier": "3.6.2",
    "typescript": "~5.8.3",
    "vitest": "^3.2.7"
  }
}
